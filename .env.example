APP_NAME="NCM Paint Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The project runs on MySQL. Create the database first:
#   mysql -u root -e "CREATE DATABASE paintcenter"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paintcenter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Must be "public" — product/brand images are uploaded to storage/app/public
# and served through the storage:link symlink.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Catalogue media (product images, brand logos) — a PUBLIC bucket, because the
# app fetches these by URL with no auth.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Message attachments — a SEPARATE, PRIVATE bucket. Customers' photos are
# readable only by the two people in the thread, and R2 has no per-object
# permissions, so this cannot share the catalogue's public bucket.
#
# On Laravel Cloud the bucket arrives via LARAVEL_CLOUD_DISK_CONFIG, which
# registers it BY NAME — there are no credentials to set here, only the name:
#   ATTACHMENTS_DISK=private
#
# Name it explicitly. Left unset on Cloud it would follow the DEFAULT disk, and
# the default moves to the public catalogue bucket the moment that one is
# attached for product images.
#
# Leave it blank locally: the service falls back to the default disk, so
# laragon needs no bucket at all.
ATTACHMENTS_DISK=

VITE_APP_NAME="${APP_NAME}"

# SMS gateway — an Android phone + SIM running an HTTP gateway app
# (app/Services/SmsService). Leave SMS_GATEWAY_URL blank to run without sending:
# in local dev, OTP codes are written to storage/logs and returned as dev_code;
# elsewhere sends are logged to sms_logs as failed. Set the phone's URL and
# credentials to send real texts (LAN IP for local mode, relay URL for cloud).
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# Require phone OTP verification before an account is created. Keep off until
# the gateway phone is live and tested; flip to true to enforce it.
OTP_ENABLED=false
